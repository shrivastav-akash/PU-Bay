# Copy to .env and fill in. Empty values fall back to the defaults noted.
PORT=
# "production" makes the session cookie Secure (HTTPS only). Default: development
NODE_ENV=
MONGO_URI=
# At least 32 random characters.
JWT_SECRET=
# Comma-separated browser origins allowed by CORS (default: http://localhost:5173,http://127.0.0.1:5173)
CLIENT_ORIGIN=
# Where uploads are stored (default: backend/uploads)
UPLOAD_DIR=
# Login/register attempts per IP per 15 minutes (default: 20)
AUTH_RATE_LIMIT=
